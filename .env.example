PORT=3000

# Django settings
DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Primary SQL Server — stable; change only on infrastructure moves
DB_SERVER_CURRENT=ERRSACTDBP1

# Optional static fallback when DB_SERVER_CURRENT is empty
DB_SERVER=localhost

# Databases — DB_CATACCUM_DATABASE changes each quarter (e.g. CatAccum2604 -> CatAccum2607)
DB_DATABASE=Catapult
DB_CATACCUM_DATABASE=CatAccum2604

# Cross-database references — update when the AIR model year or Industry DB is refreshed
AIR_EVENTS_DB=AIREvents2025_TS13
INDUSTRY_DB=Industry

# Auth mode: "windows" (Kerberos/NTLM — local domain only) | "sql" (username + password)
# NOTE: "windows" is unavailable on Databricks clusters. Use "sql" there.
DB_AUTH_MODE=windows
DB_INTEGRATED_SECURITY=true

# SQL auth credentials — used only when DB_AUTH_MODE=sql (ignored for windows auth)
DB_USER=sa
DB_PASSWORD=YourStrongPassword!
DB_PORT=1433

# Connection options
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=false
DB_CONNECT_TIMEOUT=30

# ODBC driver — override if driver version differs (e.g. driver 17 on older hosts)
# On Databricks, install via cluster init script before changing this value.
ODBC_DRIVER=ODBC Driver 18 for SQL Server
