# Secrets and local config — never commit the live env file
.env

# Python runtime
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/

# Analysis outputs — generated artifacts, not source
analysis/

# Local SQLite database (saved scenarios — each user has their own)
db.sqlite3

# Node.js
node_modules/

# VS Code local settings (keep shared settings.json, exclude personal overrides)
.vscode/settings.local.json

# OS artifacts
.DS_Store
Thumbs.db
